# Shared
APP_ENV=development
LOG_LEVEL=debug

# Database (Docker Compose)
POSTGRES_USER=biomed
POSTGRES_PASSWORD=biomed
POSTGRES_DB=biomed_cmms
DATABASE_URL=postgres://biomed:biomed@localhost:5432/biomed_cmms?sslmode=disable

# Tests (repository integration tests create this database on demand)
TEST_DATABASE_URL=postgres://biomed:biomed@localhost:5432/biomed_cmms_test?sslmode=disable

# API
API_PORT=8080

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080

# Web dev identity headers (do not commit real UUIDs)
NEXT_PUBLIC_TENANT_ID=
NEXT_PUBLIC_USER_ID=
