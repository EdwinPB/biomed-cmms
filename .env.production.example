# Production environment — biomed-cmms
#
# Copy to .env on the server (or inject into the runtime environment).
# Do NOT commit real values. Replace every <placeholder> below.
#
# Loaded by apps/api (internal/config) and the docker-compose postgres service.
# NEXT_PUBLIC_API_URL is consumed by apps/web at BUILD time.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Full PostgreSQL connection string used by the API and the migration tool.
# Managed PostgreSQL (RDS/Neon/Supabase/...) requires TLS: sslmode=require.
# Example (Docker Compose local PG):
#   postgres://biomed:biomed@localhost:5432/biomed_cmms?sslmode=disable
DATABASE_URL=postgres://<db-user>:<db-password>@<db-host>:5432/<db-name>?sslmode=require

# Docker Compose postgres service settings (only used by docker-compose.yml).
# Keep in sync with the user/password in DATABASE_URL.
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>
POSTGRES_DB=<db-name>

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# TCP port the API listens on. Default 8080.
API_PORT=8080

# Exact origin of the web app. CORS headers are emitted only when the request
# Origin matches this value exactly; credentials are allowed.
CORS_ALLOWED_ORIGIN=https://<web-host>

# Name of the session cookie. Change from the default before public use.
SESSION_COOKIE_NAME=<session-cookie-name>

# Session lifetime, e.g. 12h, 24h. Default 12h.
SESSION_TTL=12h

# ---------------------------------------------------------------------------
# Web (build-time)
# ---------------------------------------------------------------------------
# REQUIRED during `npm run build` / `make build`. The Next.js production build
# fails if this is unset. Browser requests to the API use this value; it is
# inlined into the bundle at build time, so a rebuild is needed to change it.
NEXT_PUBLIC_API_URL=https://<api-host>

# ---------------------------------------------------------------------------
# Caddy reverse proxy (Sprint 8.2.4)
# ---------------------------------------------------------------------------
# Public entrypoint domains. Caddy terminates HTTPS (Let's Encrypt) for these
# and proxies to the internal services. No real domains live in the repo.
APP_DOMAIN=<app-host>
API_DOMAIN=<api-host>

# ---------------------------------------------------------------------------
# Demo seed (Sprint 8.4)
# ---------------------------------------------------------------------------
# Optional override for the demo seed password. When unset the seed uses the
# documented default (DemoPass!123). The demo seed is for LOCAL/DEMO use only
# and must not be applied to a real customer database. Run it with:
#   docker compose --profile tools run --rm seed
SEED_DEMO_PASSWORD=
